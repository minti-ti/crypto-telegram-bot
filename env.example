# Telegram
BOT_TOKEN=123456:ABC-DEF...           # @BotFather

# Расписание утренней сводки (можно менять через /settime HH:MM)
MORNING_TIME=09:00

# ──── БД: PostgreSQL через Neon.tech (бесплатно навсегда, 0.5 GB) ────
# 1. Зарегайся на https://neon.tech (через GitHub)
# 2. Create Project → выбери регион Frankfurt
# 3. Скопируй Connection string и вставь сюда:
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/crypto-bot?sslmode=require

# CoinGecko (опционально)
COINGECKO_API_KEY=

# ──── Экономический календарь (Finnhub) + ликвидации ────
FINNHUB_API_KEY=
ECON_COUNTRIES=US,United States
ECON_MIN_IMPORTANCE=2
ECON_NOTIFY_MINUTES=60

LIQ_SYMBOLS=BTCUSDT,ETHUSDT
LIQ_THRESHOLD_USD=5000000
LIQ_LOOKBACK_MINUTES=60
LIQ_COOLDOWN_MINUTES=60

# ──── Новости: RSS + перевод на русский + опц. LLM-фильтрация ────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://www.theblock.co/rss.xml,https://decrypt.co/feed
NEWS_LOOKBACK_HOURS=24
NEWS_MAX_PER_LLM=30

# Список монет для утренней сводки (тикеры Binance)
TOP_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,TONUSDT,ADAUSDT,DOGEUSDT

# Монеты для funding rate
FUNDING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Порт для health-check (Render ставит автоматически)
PORT=8000
